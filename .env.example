# PostgreSQL
DATABASE_URL=postgres://maintainer:maintainer@localhost:5432/maintainer

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app/repositories
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app/repositories

# GitHub App — https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SETUP_URL=

# Public app URL used for GitHub App callback links
APP_BASE_URL=http://localhost:3000

# Coding model (optional — rule-based transforms are used when unset)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=

# Execution plane
# docker (default for local/dev) | isolated-process (tests / hosts without Docker)
MAINTAINER_EXECUTOR=docker
MAINTAINER_EXECUTOR_TIMEOUT_MS=600000
MAINTAINER_WORKSPACE_ROOT=/tmp/maintainer-workspaces

# Development only. Never enable in production.
# Surfaces a clearly labeled fixture installation so the full product
# journey can be exercised without GitHub App credentials.
MAINTAINER_DEV_FIXTURES=false

# Logging
LOG_LEVEL=info
